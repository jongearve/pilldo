{
  "name": "poquito",
  "version": "1.0.0",
  "description": "Poquito: tareas pequeñas, una a la vez, siempre a mano en la bandeja.",
  "main": "main.js",
  "author": "Poquito",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.poquito.app",
    "productName": "Poquito",
    "files": ["main.js", "preload.js", "src/**", "assets/**", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
